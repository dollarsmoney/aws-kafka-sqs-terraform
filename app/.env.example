# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real values.
# Used by: docker compose -f docker-compose.aiven.yml up --build

# ---------- Kafka ----------
# Native Kafka port from the Aiven console (Connection information → Client certificate)
KAFKA_BROKERS=your-kafka-service.aivencloud.com:12345
KAFKA_SSL=true
# Paths INSIDE the container. ./certs is mounted at /certs by the compose file.
KAFKA_SSL_CA_FILE=/certs/ca.pem
KAFKA_SSL_CERT_FILE=/certs/service.cert
KAFKA_SSL_KEY_FILE=/certs/service.key
# Topic NAMES this app uses. The topics themselves are created by Terraform (infra/aiven/topics.tf).
ORDERS_TOPIC=orders.created
PAYMENTS_TOPIC=payments.completed
# false = production behaviour: the app only checks topics exist. true = local dev auto-create.
KAFKA_CREATE_TOPICS=false

# ---------- SQS ----------
# Local ElasticMQ. On AWS, remove SQS_ENDPOINT and the dummy keys, and set the real queue URL.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT=http://elasticmq:9324
SQS_QUEUE_URL=http://elasticmq:9324/000000000000/order-jobs

# ---------- API ----------
PORT=3000

# ---------- Logging ----------
# debug shows every Kafka/SQS message received; info is normal; warn/error = problems only
LOG_LEVEL=info
# Added to every log line so you can filter local vs staging vs production
APP_ENV=local
